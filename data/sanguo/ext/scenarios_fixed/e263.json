 "neutral_cities": [],
 "opening_zh": "漢祚將終，金陵氣薄。魏司馬昭總攬朝綱，起十八萬虎旅南指巴蜀；漢後主暗弱，黃皓專權，維雖抱志孤懸沓中，大廈已作傾頹之勢。",
 "goal_zh": "魏掃滅蜀吳以一統天下，蜀拒險固守逆轉天命，吳乘隙北伐鼎足圖強。",
 "events": [
  {
   "turn": 2,
   "text_zh": "鍾會、鄧艾、諸葛緒兵分三路大舉攻蜀，漢中關隘相繼失守。"
  },
  {
   "turn": 3,
   "text_zh": "鄧艾裹氈度過陰平險道，綿竹諸葛瞻父子戰死，後主劉禪出降，蜀漢滅亡。"
  },
  {
   "turn": 4,
   "text_zh": "鍾會密結姜維意圖反叛自立，事敗身死於成都，蜀地陷入兵亂。"
  },
  {
   "turn": 6,
   "text_zh": "吳主孫休崩逝，丞相濮陽興等迎立烏程侯孫皓為帝。"
  },
  {
   "turn": 11,
   "text_zh": "魏帝曹奐禪位於相國晉王司馬炎，魏亡，西晉建立。"
  }
 ],
