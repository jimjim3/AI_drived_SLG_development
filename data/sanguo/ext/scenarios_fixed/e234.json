 "neutral_cities": [],
 "opening_zh": "歲在甲寅，漢丞相諸葛亮大舉出師，屯田五丈原，魏都督司馬懿堅壁據守，渭水兩岸風雲際會。東吳大帝孫權亦整肅水陸大軍北向響應。天下三分鼎足數十載，漢室克復與魏室存亡，盡繫於此役。",
 "goal_zh": "挫敗宿敵之進攻並兼併群雄，終結三國鼎立一統天下。",
 "events": [
  {
   "turn": 1,
   "text_zh": "諸葛亮大軍進抵五丈原分兵屯田，孫權起兵三路伐魏攻合肥、襄陽。"
  },
  {
   "turn": 3,
   "text_zh": "諸葛亮積勞成疾病逝五丈原，蜀軍依策退兵，魏延爭權兵敗被誅。"
  },
  {
   "turn": 5,
   "text_zh": "蔣琬受命主持蜀漢朝政安撫內外，魏帝曹叡於洛陽大興土木營建宮室。"
  },
  {
   "turn": 15,
   "text_zh": "遼東公孫淵叛魏自立為燕王並改元紹漢，引發北方局勢動盪。"
  },
  {
   "turn": 19,
   "text_zh": "司馬懿率魏軍圍攻襄平平定遼東，斬公孫淵，遼東收歸魏轄。"
  }
 ],
