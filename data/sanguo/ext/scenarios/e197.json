 "opening_zh": "建安二年春，淮南袁公路恃其累世之望、玉璽在手，遂於壽春僭號稱尊。逆節既萌，海內震動！漢祚傾頹之際，曹孟德奉天子以討不臣，孫伯符橫掃江表，袁本初大兵壓境易京。天下諸侯各懷異心，四海鼎沸，社稷存亡在此一役！",
 "goal_zh": "平定偽朝袁術，翦滅群雄以一統天下。",
 "events": [
  {
   "turn": 1,
   "text_zh": "宛城事變：曹操南征張繡，張繡降而復叛，曹軍大敗，大將典韋、長子曹昂戰死宛城。"
  },
  {
   "turn": 2,
   "text_zh": "孫策絕袁：孫策修書嚴辭斥責袁術稱帝僭越之罪，正式脫離袁術自立，江東徹底獨立。"
  },
  {
   "turn": 3,
   "text_zh": "壽春討伐戰：曹操聯結呂布、孫策四路大軍圍剿淮南，大破袁術，斬其大將橋蕤。"
  },
  {
   "turn": 7,
   "text_zh": "下邳之戰：曹操東征徐州水淹下邳，呂布部將反叛獻城，呂布、陳宮兵敗殞命。"
  },
  {
   "turn": 9,
   "text_zh": "易京之戰：袁紹發重兵掘地道破易京樓，公孫瓚窮途末路自焚而亡，袁紹一統河北四州。"
  }
 ],
 "difficulty": 3,
 "verification": "unverified"
}