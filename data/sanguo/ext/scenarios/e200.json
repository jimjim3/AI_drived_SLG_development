 "opening_zh": "建安五年春，袁本初席捲幽冀，督十萬之眾臨河而誓；曹孟德兼領兗豫，奉天子以制豪雄。徐方劉備密謀誅曹事敗，阻兵下邳；江東孫郎席捲三江，虎視江表。南北二雄對壘中原，天下裂變之機，皆發於官渡之野。",
 "goal_zh": "擊破河北袁氏與四方敵對群雄，定鼎中原一統天下。",
 "events": [
  {
   "turn": 1,
   "text_zh": "曹操親征徐州破下邳，劉備北投袁紹，關羽約三事暫歸曹操。"
  },
  {
   "turn": 2,
   "text_zh": "白馬延津之戰爆發，顏良、文醜相繼陣亡，袁紹大軍南渡逼近官渡。"
  },
  {
   "turn": 2,
   "text_zh": "江東孫策遇刺身亡，其弟孫權承繼父兄基業，張昭、周瑜輔政定局。"
  },
  {
   "turn": 4,
   "text_zh": "許攸夜奔曹營獻計，曹操夜襲烏巢焚毀袁軍糧秣，袁紹官渡潰敗。"
  },
  {
   "turn": 8,
   "text_zh": "倉亭之戰爆發，曹操擊潰袁紹殘部，河北勢力自此轉入守勢。"
  },
  {
   "turn": 10,
   "text_zh": "袁紹憂憤發病去世，諸子袁譚、袁尚爭立奪嫡，河北陷於內訌。"
  }
 ],
