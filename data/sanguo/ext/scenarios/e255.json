 "neutral_cities": [],
 "opening_zh": "高貴鄉公登基，司馬師擅權日甚。毌丘儉、文欽起兵淮南以清君側，移檄四方；西陲姜維出漢中長驅隴右，欲乘中原之隙克復中原；江東孫吳伺機引兵北進。魏鼎將傾，天下三分再啟劇烈風雲。",
 "goal_zh": "平定叛亂穩固政權，或乘勢北伐中原統一天下。",
 "events": [
  {
   "turn": 1,
   "text_zh": "毌丘儉、文欽於壽春誓師討伐司馬師，遣使連通孫吳，淮南震動。"
  },
  {
   "turn": 2,
   "text_zh": "司馬師抱病親征淮南，文鴦單騎夜襲魏營；司馬師目疾暴發，不久病逝於許昌，司馬昭總領軍國大權。"
  },
  {
   "turn": 3,
   "text_zh": "姜維率蜀軍出祁山發動北伐，於洮西大破魏將王經，斬首數萬，乘勝圍困狄道。"
  },
  {
   "turn": 4,
   "text_zh": "魏將陳泰、鄧艾合力馳援隴西解狄道之圍，姜維糧盡引兵退保鍾提。"
  },
  {
   "turn": 5,
   "text_zh": "諸葛誕繼任征東大將軍後心不自安，於壽春起兵抗拒司馬昭，淮南三叛終局揭幕。"
  }
 ],
