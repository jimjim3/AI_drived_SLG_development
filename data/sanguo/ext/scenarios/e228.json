 "neutral_cities": [],
 "opening_zh": "建興六年春，漢丞相諸葛亮統率三軍進駐漢中，誓師北伐。先帝託孤之重，天下鼎立之勢，皆係於此役。中原魏室赫赫，江東孫吳虎視，北伐大業，成敗在此一舉。",
 "goal_zh": "克復中原，還於舊都，一統天下。",
 "events": [
  {
   "turn": 1,
   "text_zh": "司馬懿疾馳新城斬孟達；諸葛亮出祁山，天水、南安、安定三郡叛魏應亮，關中大震。"
  },
  {
   "turn": 2,
   "text_zh": "馬謖違亮節度失守街亭，魏將張郃長驅直入，蜀軍拔西縣千餘家退還漢中。"
  },
  {
   "turn": 3,
   "text_zh": "吳鄱陽太守周魴斷髮詐降，誘魏大司馬曹休入伏，陸遜大破魏軍於石亭。"
  },
  {
   "turn": 4,
   "text_zh": "諸葛亮復出散關圍陳倉，魏守將郝昭以三千之眾堅守二十餘日，蜀軍糧盡引退。"
  },
  {
   "turn": 6,
   "text_zh": "孫權於武昌登基稱帝，改元黃龍，旋即遷都建業，遣使通蜀重申盟好。"
  },
  {
   "turn": 14,
   "text_zh": "諸葛亮再次北伐圍祁山，於上邽割麥，司馬懿督諸軍迎戰，兩軍對峙於鹵城。"
  }
 ],
 "difficulty": 3,
