 "opening_zh": "建安四年春，漢室衰微，群雄並起。曹操挾天子而撫中原，袁紹席捲河北帶甲數十萬，南北對峙之勢已成；江東小霸王孫策虎踞揚州，英姿勃發。天下分崩，大戰一觸即發，四海英雄誰能底定乾坤？",
 "goal_zh": "消滅敵對割據勢力，統一華夏重定天下。",
 "events": [
  {
   "turn": 1,
   "text_zh": "易京之戰公孫瓚潰敗引火自焚，袁紹盡得幽州之地，河北四州遂告底定。"
  },
  {
   "turn": 2,
   "text_zh": "袁術勢窮欲北投袁紹，途中受阻病死江亭，廬江太守劉勳收容其餘眾。"
  },
  {
   "turn": 3,
   "text_zh": "孫策用計誘襲廬江擊潰劉勳，旋即進兵沙羨重創黃祖，並平定豫章郡。"
  },
  {
   "turn": 4,
   "text_zh": "張繡採納賈詡之策率軍降附曹操，曹操大悅，官渡後方之患遂解。"
  },
  {
   "turn": 5,
   "text_zh": "衣帶詔事發董承等人遇害，劉備殺徐州刺史車冑起兵反曹，曹操親率大軍東征討劉。"
  },
  {
   "turn": 7,
   "text_zh": "官渡決戰揭開序幕，曹操與袁紹主力相持於官渡；孫策遇刺重傷不治，孫權繼領江東。"
  }
 ],
 "difficulty": 3,
